STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Generate a unique value per environment, e.g. `openssl rand -base64 48`.
# NEVER reuse the same secret across dev/staging/production, and never
# commit a real value here — medusa-config.ts refuses to boot in production
# with an empty, short, or known-placeholder secret.
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=
DB_NAME=medusa-backend

# ---------------------------------------------------------------------------
# Sentry — error tracking. Sin esto, un fallo en la autorización de pago o
# en el job de reconciliación es invisible hasta que un cliente reclama.
# Clave gratuita en https://sentry.io
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Webpay Plus (Transbank) — pago real Chile
# Estas son las credenciales de INTEGRACIÓN públicas que Transbank publica
# para que cualquier desarrollador pueda probar sin afiliación comercial.
# Cámbialas por tus credenciales reales al afiliarte: https://www.transbankdevelopers.cl
# ---------------------------------------------------------------------------
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TRANSBANK_ENVIRONMENT=integration
# A dónde redirige Transbank al terminar el pago (server.ts del storefront).
TRANSBANK_RETURN_URL=http://localhost:3000/webpay/return

# ---------------------------------------------------------------------------
# Mercado Pago — necesitas tu propio access token de prueba (gratis, autoservicio):
# https://www.mercadopago.cl/developers/panel/app
# ---------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SUCCESS_URL=http://localhost:3000/checkout/confirmar?provider=mercadopago
MERCADOPAGO_FAILURE_URL=http://localhost:3000/checkout/confirmar?provider=mercadopago&cancelled=1
# Debe apuntar a /hooks/payment/mercadopago_mercadopago (fijo: identifier "mercadopago" + id "mercadopago").
MERCADOPAGO_NOTIFICATION_URL=http://localhost:9000/hooks/payment/mercadopago_mercadopago

# ---------------------------------------------------------------------------
# Stripe — necesitas tu propia clave secreta de prueba (gratis, autoservicio):
# https://dashboard.stripe.com/test/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Chilexpress — aún sin cuenta de desarrollador. Mientras estas variables
# estén vacías, el envío usa una tarifa fija ($3.990) sin romper el checkout.
# Regístrate en https://developers.chilexpress.cl para obtener credenciales.
# ---------------------------------------------------------------------------
CHILEXPRESS_API_KEY=
CHILEXPRESS_BASE_URL=https://services.wschilexpress.com
CHILEXPRESS_ORIGIN_CODE=
CHILEXPRESS_FALLBACK_RATE=3990

# ---------------------------------------------------------------------------
# Resend — email de confirmación de compra. Clave gratuita en https://resend.com
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=pedidos@kinetic-sports.cl

STORE_CORS=http://localhost:8000,http://localhost:3000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Generate a unique value per environment, e.g. `openssl rand -base64 48`.
# NEVER reuse the same secret across dev/staging/production, and never
# commit a real value here — medusa-config.ts refuses to boot in production
# with an empty, short, or known-placeholder secret.
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=
DB_NAME=medusa-backend

# ---------------------------------------------------------------------------
# Sentry — error tracking. Sin esto, un fallo en la autorización de pago o
# en el job de reconciliación es invisible hasta que un cliente reclama.
# Clave gratuita en https://sentry.io
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Webpay Plus (Transbank) — pago real Chile
# Estas son las credenciales de INTEGRACIÓN públicas que Transbank publica
# para que cualquier desarrollador pueda probar sin afiliación comercial.
# Cámbialas por tus credenciales reales al afiliarte: https://www.transbankdevelopers.cl
# ---------------------------------------------------------------------------
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TRANSBANK_ENVIRONMENT=integration
# A dónde redirige Transbank al terminar el pago (server.ts del storefront).
TRANSBANK_RETURN_URL=http://localhost:3000/webpay/return

# ---------------------------------------------------------------------------
# Mercado Pago — necesitas tu propio access token de prueba (gratis, autoservicio):
# https://www.mercadopago.cl/developers/panel/app
# ---------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SUCCESS_URL=http://localhost:3000/checkout/confirmar?provider=mercadopago
MERCADOPAGO_FAILURE_URL=http://localhost:3000/checkout/confirmar?provider=mercadopago&cancelled=1
# Debe apuntar a /hooks/payment/mercadopago_mercadopago (fijo: identifier "mercadopago" + id "mercadopago").
MERCADOPAGO_NOTIFICATION_URL=http://localhost:9000/hooks/payment/mercadopago_mercadopago

# ---------------------------------------------------------------------------
# Khipu — transferencia bancaria instantánea (Chile). A diferencia de Webpay,
# Khipu NO publica credenciales de prueba compartidas: necesitas tu propia
# cuenta y API Key aunque solo quieras probar con el "DemoBank" (RUT/clave
# 1234/cuenta de prueba). Créala en https://khipu.com > panel de comercio >
# API Keys.
# ---------------------------------------------------------------------------
KHIPU_API_KEY=
# Secreto para verificar la firma `x-khipu-signature` de los webhooks (ver
# payment-khipu/service.ts). NO es el API Key — en el panel de Khipu es la
# "Llave de cobrador", bajo "Identificación del cobrador" (junto al Id de
# cobrador). No 100% confirmado por la doc de Khipu, pero si está mal no pasa
# nada: la firma simplemente no valida (se loguea) y el pago igual se
# confirma vía reconcile-payments.ts, que consulta el estado real a Khipu.
KHIPU_WEBHOOK_SECRET=
KHIPU_RETURN_URL=http://localhost:3000/checkout/confirmar?provider=khipu
KHIPU_CANCEL_URL=http://localhost:3000/checkout/confirmar?provider=khipu&cancelled=1
# OJO: a diferencia de Mercado Pago, Khipu VALIDA esta URL en el momento de
# crear el pago — si no es alcanzable públicamente (localhost), la API
# responde 400 y el pago ni se crea (no es solo que el webhook no llegue).
# Verificado 2026-09-28 con curl directo contra payment-api.khipu.com. Déjala
# vacía en desarrollo (el provider ya omite el campo si está vacío) y confía
# en reconcile-payments.ts, o usa un túnel (ngrok) si necesitas probar el
# webhook real.
KHIPU_NOTIFY_URL=

# ---------------------------------------------------------------------------
# Stripe — necesitas tu propia clave secreta de prueba (gratis, autoservicio):
# https://dashboard.stripe.com/test/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Chilexpress — mientras estas variables estén vacías (o la comuna no se
# pueda resolver), el envío usa una tarifa fija ($3.990) sin romper el
# checkout. Regístrate en https://developers.wschilexpress.com y suscríbete
# a DOS productos por separado: "Cotizador" (tarifica) y "Coberturas" (traduce
# la comuna del cliente a un countyCode — ver coverage.ts, sin esto la
# cotización real nunca funciona aunque CHILEXPRESS_API_KEY esté configurado).
# ---------------------------------------------------------------------------
CHILEXPRESS_API_KEY=
CHILEXPRESS_BASE_URL=https://services.wschilexpress.com
# countyCode Chilexpress (no el nombre de la comuna) de tu bodega/origen de
# despacho. Verifícalo contra la API "Consultar Coberturas" — el nombre de
# comuna que usa Chilexpress no siempre coincide con el oficial (ej. la
# comuna "Santiago" es "SANTIAGO CENTRO"/"STGO" en su sistema).
CHILEXPRESS_ORIGIN_CODE=
# Dirección de la bodega — usada como origen/remitente al generar envíos.
# Verifica el nombre exacto de la calle contra la API "Consultar Calles".
CHILEXPRESS_ORIGIN_STREET=
CHILEXPRESS_ORIGIN_STREET_NUMBER=
CHILEXPRESS_FALLBACK_RATE=3990
# Key de la suscripción "Coberturas" — distinta de CHILEXPRESS_API_KEY (que es de "Cotizador").
CHILEXPRESS_COBERTURA_API_KEY=
CHILEXPRESS_COBERTURA_BASE_URL=https://services.wschilexpress.com
# "Envíos" — genera la guía/etiqueta real y el tracking. Necesitas además un
# TCC (Tarjeta Cliente Chilexpress) de una cuenta COMERCIAL para producción;
# el valor de prueba oficial (18578680) solo sirve en sandbox.
CHILEXPRESS_ENVIOS_API_KEY=
# Pruebas: http://testservices.wschilexpress.com — Producción: https://services.wschilexpress.com
CHILEXPRESS_ENVIOS_BASE_URL=http://testservices.wschilexpress.com
# TCC y RUT de la empresa (sin puntos ni dígito verificador). Pruebas: 18578680 y 96756430.
CHILEXPRESS_TCC=
CHILEXPRESS_RUT=
# Remitente de los envíos (la dirección sale de CHILEXPRESS_ORIGIN_STREET/_NUMBER).
CHILEXPRESS_SENDER_NAME=
CHILEXPRESS_SENDER_PHONE=
CHILEXPRESS_SENDER_EMAIL=

# ---------------------------------------------------------------------------
# Resend — email de confirmación de compra. Clave gratuita en https://resend.com
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=pedidos@kinetic-sports.cl
# URL pública de la tienda (sin / final). Se usa para los links de los correos (seguimiento).
STOREFRONT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SimpleFactura — boleta electrónica automática al crear el pedido
# (https://api.simplefactura.cl). Sin EMAIL, PASSWORD y RUT_EMISOR no se emite nada.
# ---------------------------------------------------------------------------
# Usuario del portal de SimpleFactura (el demo público sirve para pruebas).
SIMPLEFACTURA_EMAIL=
SIMPLEFACTURA_PASSWORD=
# RUT de la empresa emisora, sin puntos y con guion (ej: 78181331-1).
SIMPLEFACTURA_RUT_EMISOR=
# Datos del emisor que salen impresos en la boleta.
SIMPLEFACTURA_RAZON_SOCIAL=
SIMPLEFACTURA_GIRO=
SIMPLEFACTURA_DIR_ORIGEN=
SIMPLEFACTURA_COMUNA_ORIGEN=
# Códigos de actividad económica del SII (hasta 4, separados por coma). La FACTURA los exige.
SIMPLEFACTURA_ACTECO=
SIMPLEFACTURA_TELEFONO=
SIMPLEFACTURA_CORREO_EMISOR=
# Nombre de la sucursal tal como aparece en SimpleFactura (por defecto "Casa Matriz").
SIMPLEFACTURA_SUCURSAL=Casa Matriz
# 0 = certificación (sin validez tributaria), 1 = producción. Debe coincidir con el ambiente de tu cuenta.
SIMPLEFACTURA_AMBIENTE=0

# ---------------------------------------------------------------------------
# Login con Google (opcional). Credenciales: Google Cloud Console →
# Google Auth Platform → Clientes → Aplicación web.
# La URL de callback es una página del STOREFRONT y debe estar registrada tal
# cual en "URIs de redireccionamiento autorizados". Si falta alguna variable,
# el proveedor no se registra y el login con correo sigue funcionando.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ---------------------------------------------------------------------------
# Webpay Oneclick Mall (Transbank) — cobro recurrente de suscripciones.
# Sin variables usa las credenciales públicas de integración. En producción
# requiere contratar Oneclick Mall con Transbank (código de comercio propio,
# distinto del de Webpay Plus) y su código hijo.
# ---------------------------------------------------------------------------
ONECLICK_ENVIRONMENT=integration
ONECLICK_COMMERCE_CODE=
ONECLICK_CHILD_COMMERCE_CODE=
ONECLICK_API_KEY=
# A esta URL del BACKEND vuelve el navegador desde Transbank al terminar la
# inscripción de la tarjeta (debe ser pública en producción).
ONECLICK_RESPONSE_URL=http://localhost:9000/hooks/oneclick-inscription

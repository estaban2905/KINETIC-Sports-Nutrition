# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# STOREFRONT SERVER (server.ts) — serves the Vite/static React app
# ==============================================================================
PORT=3000
NODE_ENV=development

# ==============================================================================
# MEDUSA BACKEND CONNECTION (real ecommerce + landing content: products, cart,
# checkout, orders, hero/benefits/faq/testimonials)
# Backend runs separately from apps/backend — see apps/backend/.env for its own config.
# ==============================================================================
VITE_MEDUSA_BACKEND_URL="http://localhost:9000"
VITE_MEDUSA_PUBLISHABLE_KEY=""

# Stripe publishable key (test mode), from https://dashboard.stripe.com/test/apikeys
# Must match the STRIPE_SECRET_KEY set in apps/backend/.env (same Stripe account).
VITE_STRIPE_PUBLISHABLE_KEY=""

# Sentry — error tracking for the checkout flow. Clave gratuita en https://sentry.io
VITE_SENTRY_DSN=""

# Funcionalidades en desarrollo — apagadas por defecto. Pon "true" para activarlas.
# Suscripción mensual: hoy no existe cobro recurrente, así que no se debe ofrecer.
VITE_ENABLE_SUBSCRIPTIONS="false"
# Cuentas de cliente (registro, login, historial de pedidos).
VITE_ENABLE_ACCOUNTS="false"
# Botón "Continuar con Google" (requiere GOOGLE_CLIENT_ID/SECRET/CALLBACK_URL en el backend).
VITE_ENABLE_GOOGLE_LOGIN="false"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# MEDUSA BACKEND ECOMMERCE ENVIRONMENT VARIABLES
# ==============================================================================
# Port & Runtime Environment
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/medusa_kinetic"

# Redis Cache & Event Bus (Optional in dev, required in high-traffic production)
REDIS_URL="redis://localhost:6379"

# CORS Configurations (Comma-separated URLs, do not use * in production)
STORE_CORS="http://localhost:3000,http://localhost:5173,https://ais-dev-tbrpbqovrw4polo7q4ifuo-355755459110.us-east1.run.app"
ADMIN_CORS="http://localhost:3000,http://localhost:7001,http://localhost:9000"
AUTH_CORS="http://localhost:3000,http://localhost:5173"

# Authentication & Security Secrets
JWT_SECRET="super-secret-jwt-kinetic-token-key"
COOKIE_SECRET="super-secret-cookie-kinetic-token-key"

# External File Storage (S3 / Cloud Storage / CDN for optimized WebP product media)
STORAGE_URL="https://storage.googleapis.com/kinetic-sports-nutrition"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="kinetic-assets"

# Payment Gateways (Chile / Multi-region)
MERCADO_PAGO_ACCESS_TOKEN=""
WEBPAY_COMMERCE_CODE=""
WEBPAY_API_KEY=""
STRIPE_API_KEY=""

# Webhooks Secret
WEBHOOK_SECRET="whsec_kinetic_super_secret"

